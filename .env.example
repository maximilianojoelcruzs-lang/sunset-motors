# Copia este archivo a .env.local para trabajar en tu computador.
# En producción, todo esto va en Vercel: Settings -> Environment Variables.
# Guía completa paso a paso en PUBLICAR.md.

# --- Sesiones ---
# Llave con la que se firman las cookies. No es la clave de nadie: es un valor largo y al
# azar, distinto de las claves de los usuarios.
#
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Si no está definida: en desarrollo se usa un valor fijo; en producción nadie entra.
# Cambiarla cierra todas las sesiones abiertas.
# Este archivo SÍ se sube a GitHub: es la plantilla, no la configuración real.
# Nunca pongas un valor de verdad acá. Los valores reales van en .env.local (que sí está
# ignorado por git) y en las variables de entorno de Vercel.
SUNSET_SECRETO=pon-aqui-un-valor-largo-y-al-azar

# --- Base de datos (usuarios y turnos) ---
# Supabase. La URL y la llave salen de Project Settings -> API.
# OJO: la llave service_role, NO la anon. Nunca le pongas el prefijo NEXT_PUBLIC_ ni la
# subas a GitHub: es la llave maestra de la base.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Alternativa: si ya tienes un Redis (Vercel KV o Upstash) sirve igual. La app usa Supabase
# si están las dos variables de arriba; si no, mira estas; si no hay ninguna, escribe en
# .datos/*.json, que en Vercel se borra en cada despliegue.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Los usuarios y sus claves NO van en variables ni en el código: viven en la base, con la
# clave guardada como hash. Para crear el primero:
#   npm run usuarios crear <usuario> <clave> -- --admin
